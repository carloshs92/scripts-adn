# Retirado — el vector store se dio de baja y la extracción corre sobre
# OpenRouter. Se descomenta solo para volver a LLM_PROVIDER=openai.
# OPENAI_API_KEY=sk-your-api-key-here

# Proveedor de LLM para la extracción (opcional)
# openrouter → usa OPENROUTER_API_KEY | openai → usa OPENAI_API_KEY
# Sin definir: openrouter si hay OPENROUTER_API_KEY, si no openai
LLM_PROVIDER=openrouter

# API key de OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# Modelo de extracción (opcional). OpenRouter exige el prefijo del proveedor.
# Default: openai/gpt-4o-mini en OpenRouter, gpt-4o-mini en OpenAI
LLM_MODEL=openai/gpt-4o-mini

# Google Drive (para npm run sync:spreadsheet)
# ID de la carpeta destino — solo el ID, extraído de la URL:
# drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=your-folder-id-here
